# Chép thành .env rồi điền. File .env chứa bí mật: KHÔNG đưa lên git, không gửi cho ai.
PORT=8080
PUBLIC_URL=https://ten-mien-cua-ban.vn
DATA_DIR=/opt/golden-duck/data
WEB_DIR=/opt/golden-duck/app/dist-server

# Khoá AI của chủ app (console.anthropic.com). Để trống thì chat AI tắt.
ANTHROPIC_API_KEY=
CHAT_MODEL=claude-haiku-5-5

# Bot chung: tạo ở @BotFather, dán mã vào đây.
TELEGRAM_BOT_TOKEN=

# Tài khoản đọc kênh: lấy ở my.telegram.org → API development tools.
TG_API_ID=
TG_API_HASH=

# Giới hạn theo gói
FREE_CHAT_PER_DAY=15
PRO_CHAT_PER_DAY=200
FREE_CHANNELS=3
PRO_CHANNELS=20
